{
  "name": "@opsimathically/httpmitm",
  "version": "1.0.1",
  "description": "Typed Node.js HTTP, HTTPS, and WebSocket MITM proxy with awaited callbacks, native zstd, and configurable certificate storage.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "scripts": {
    "build": "npm run ts-to-zod && tsup",
    "test": "node --require ts-node/register --require tsconfig-paths/register --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "ts-to-zod": "ts-to-zod --config=zod-to-ts",
    "docs": "typedoc",
    "audit:prod": "npm audit --omit=dev",
    "pack:dry": "npm pack --dry-run",
    "smoke:package": "node scripts/package-smoke.mjs",
    "bench": "npm run build && node benchmarks/run-benchmarks.mjs",
    "bench:quick": "npm run build && node benchmarks/run-benchmarks.mjs --profile quick",
    "bench:json": "npm run build && node benchmarks/run-benchmarks.mjs --json",
    "verify": "npm run build && npm run typecheck && npm run lint && npm run docs && npm test && npm run audit:prod && npm run pack:dry && npm run smoke:package",
    "prepack": "npm run build"
  },
  "keywords": [
    "mitm",
    "proxy",
    "http",
    "https",
    "websocket",
    "interception"
  ],
  "engines": {
    "node": ">=26"
  },
  "homepage": "https://github.com/opsimathically/httpmitm",
  "devDependencies": {
    "@types/async": "^3.2.25",
    "@types/node-forge": "^1.3.14",
    "esbuild": "^0.25.0",
    "eslint": "^9.20.1",
    "globals": "^15.14.0",
    "node-forge": "^1.4.0",
    "prettier": "^3.5.0",
    "ts-node": "^10.9.2",
    "ts-to-zod": "^5.1.0",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.1",
    "typedoc-plugin-markdown": "^4.6.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "zod": "^4.4.3"
  },
  "author": "Jason Medeiros",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opsimathically/httpmitm.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@peculiar/x509": "^2.0.0",
    "@types/node": "^26.1.0",
    "@types/semaphore": "^1.1.4",
    "@types/ws": "^8.18.1",
    "async": "^3.2.6",
    "reflect-metadata": "^0.2.2",
    "semaphore": "^1.1.0",
    "tldts": "^7.4.6",
    "uuid": "^11.1.1",
    "ws": "^8.21.0"
  }
}
